# EVENTHUB Environment Variables Template
# Copy this file to .env and replace placeholders with your actual local configuration.
# NEVER commit the real .env file or credentials to version control.

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/eventhub

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=EVENTHUB
